node_modules/safer-buffer/dangerous.js
node_modules/safer-buffer/Porting-Buffer.md
out/**/*.map
dist/webviews/*.map
# Exclude build scripts (not needed in published extension)
scripts/copy-scripts.js
# Exclude other logo files, keep only android-studio-macos-transparent.png
assets/android-studio-macos-dark-transparent.png
assets/android-studio-macos-dark.png
assets/android-studio-macos.png
assets/Extension_*.png.
